import { LineEdit, ComboBox, ScrollView, ProgressIndicator, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ModTile {
    id: string,
    name: string,
    note: string,
    icon: image,
    action: string,
    busy: bool,
    progress: float,
    indeterminate: bool,
    versions: [string],
    version: string,
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: Theme.caption-size;
    font-family: Theme.font;
    // без явной высоты подпись растягивается вместе с остальными элементами
    // колонки и центрируется — из-за этого под ней появляется пустота
    height: self.font-size + 4px;
    vertical-alignment: bottom;
}

component Body inherits Text {
    color: Theme.fg;
    font-size: Theme.body-size;
    font-family: Theme.font;
    wrap: word-wrap;
}

component Card inherits Rectangle {
    background: Theme.layer;
    border-radius: Theme.radius;
    border-width: Theme.stroke-width;
    border-color: Theme.stroke;
}

component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 42px;
    border-radius: Theme.radius-small;
    background: !root.enabled ? Theme.card
        : ta.pressed ? Theme.accent-dark
        : ta.has-hover ? Theme.accent-dark
        : Theme.accent;
    animate background { duration: 120ms; }
    Text {
        text: root.text;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: Theme.font;
        font-size: Theme.body-strong-size;
        font-weight: 700;
        color: root.enabled ? Theme.on-accent : Theme.muted;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SubtleButton inherits Rectangle {
    in property <string> text;
    in property <bool> accent-text: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    min-width: txt.preferred-width + 28px;
    border-radius: Theme.radius-small;
    border-width: Theme.stroke-width;
    border-color: Theme.stroke;
    background: !root.enabled ? Theme.layer
        : ta.pressed ? Theme.layer : ta.has-hover ? Theme.card-hover : Theme.card;
    animate background { duration: 120ms; }
    txt := Text {
        text: root.text;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: Theme.font;
        font-size: Theme.body-size;
        color: !root.enabled ? Theme.muted : root.accent-text ? Theme.accent : Theme.fg;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// Фирменная зелёная полоса: процентная либо бегущая при неизвестном размере.
component ModInstallProgress inherits Rectangle {
    in property <float> progress;
    in property <bool> indeterminate;
    property <float> sweep: root.indeterminate ? 1 : 0;
    height: 8px;
    border-radius: 4px;
    background: Theme.accent-soft;
    clip: true;
    animate sweep {
        duration: 1100ms;
        iteration-count: -1;
        easing: ease-in-out;
    }
    Rectangle {
        x: root.indeterminate ? (root.width + self.width) * root.sweep - self.width : 0px;
        width: root.indeterminate ? Math.max(72px, root.width * 0.28)
            : root.width * Math.max(0, Math.min(100, root.progress)) / 100;
        height: 100%;
        border-radius: 4px;
        background: Theme.accent;
        animate width { duration: 160ms; easing: ease-out; }
    }
}

// Элемент NavigationView в стиле WinUI 3
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: Theme.nav-item-height;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.card : ta.has-hover ? Theme.card-hover : transparent;
    animate background { duration: 120ms; }
    Rectangle {
        x: 3px;
        y: (root.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: root.selected ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.icon;
            vertical-alignment: center;
            font-size: 15px;
            color: root.selected ? Theme.accent : Theme.muted;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-family: Theme.font;
            font-size: Theme.body-size;
            color: root.selected ? Theme.fg : Theme.fg;
        }
        Rectangle { }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Горизонтальная плитка мода (иконка слева, текст и кнопка справа)
component ModCard inherits Card {
    in property <ModTile> mod;
    callback action(ModTile);
    height: 112px;
    background: ta.has-hover ? Theme.card : Theme.layer;
    animate background { duration: 120ms; }
    ta := TouchArea { }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Rectangle {
            width: 64px;
            height: 64px;
            y: (parent.height - 64px) / 2;
            border-radius: Theme.radius-small;
            background: Theme.card;
            clip: true;
            Image {
                source: root.mod.icon;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            Text {
                text: root.mod.name;
                font-family: Theme.font;
                font-size: Theme.body-strong-size;
                font-weight: 600;
                color: Theme.fg;
                overflow: elide;
            }
            Text {
                text: root.mod.note;
                font-family: Theme.font;
                font-size: Theme.caption-size;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            if root.mod.busy : ModInstallProgress {
                width: 120px;
                progress: root.mod.progress;
                indeterminate: root.mod.indeterminate;
            }
            if !root.mod.busy : SubtleButton {
                text: root.mod.action;
                accent-text: true;
                clicked => { root.action(root.mod); }
            }
        }
    }
}

// Адаптивная сетка карточек: плитки стоят в ряд и переносятся по ширине окна
component ModGrid inherits Rectangle {
    in property <[ModTile]> model;
    callback action(ModTile);
    property <length> gap: 12px;
    property <length> card-height: 112px;
    property <float> cols: Math.max(1, Math.floor(root.width / 320px));
    property <length> cell: (root.width - root.gap * (root.cols - 1)) / root.cols;
    property <float> rows: Math.ceil(root.model.length / root.cols);
    height: root.model.length > 0
        ? root.rows * root.card-height + (root.rows - 1) * root.gap
        : 0px;
    for m[i] in root.model : ModCard {
        mod: m;
        width: root.cell;
        x: Math.mod(i, root.cols) * (root.cell + root.gap);
        y: Math.floor(i / root.cols) * (root.card-height + root.gap);
        action(t) => { root.action(t); }
    }
}

export component AppWindow inherits Window {
    title: "Cactus Lite Minecraft v1.3";
    background: Theme.bg;
    default-font-family: Theme.font;
    preferred-width: 940px;
    preferred-height: 640px;
    min-width: 820px;
    min-height: 580px;

    // Состояние
    in-out property <int> page: 0;
    in-out property <string> nick;
    in-out property <string> version;
    in property <[string]> versions;
    in-out property <string> ram;
    in property <[string]> rams;
    in-out property <string> loader;
    in property <[string]> loaders;
    in property <string> status;
    in property <float> progress;
    in property <bool> busy: false;
    in property <string> playtime;
    in property <string> game-dir;
    in property <string> app-version: "v1.3";
    in property <image> logo;
    in property <image> skin-preview;
    in property <[ModTile]> catalog;
    in property <[ModTile]> found;
    in property <[string]> installed-instances;
    in property <[ModTile]> installed-mods;
    in-out property <string> selected-installed-instance;
    in property <string> mods-status;
    in property <bool> mod-install-busy: false;
    in property <float> mod-install-progress: 0;
    in property <bool> mod-install-indeterminate: false;
    in property <string> mod-install-name;
    in-out property <string> query;
    in property <[string]> changelog;
    in-out property <bool> repair-deps-on-launch: true;
    in property <[string]> all-versions;
    in-out property <bool> add-open: false;
    in-out property <bool> only-release: true;
    in-out property <string> new-version;
    in property <string> add-status;
    in-out property <string> version-filter;

    // Диалог выбора версии мода (вместо выпадающего списка в плитке)
    property <ModTile> mod-dlg-tile;
    property <bool> mod-dlg-found: false;
    in-out property <bool> mod-dlg-open: false;
    in-out property <string> mod-dlg-version;

    // Действия для Python
    callback launch();
    callback add-version();
    callback version-changed(string);
    callback ram-changed(string);
    callback loader-changed(string);
    callback pick-skin();
    callback reset-skin();
    callback reset-settings();
    callback open-game-dir();
    callback open-mods-dir();
    callback pick-mod-file();
    callback search-mods();
    callback install-mod(string, string);
    callback install-found(string, string);
    callback installed-instance-changed(string);
    callback remove-mod(string, string);
    callback toggle-console();
    callback only-release-changed(bool);
    callback install-version(string);
    callback version-filter-changed(string);
    callback repair-deps-changed(bool);

    HorizontalLayout {
        spacing: 0px;

        // NavigationView (WinUI 3)
        Rectangle {
            width: Theme.nav-width;
            background: Theme.layer;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Image {
                    source: root.logo;
                    height: 56px;
                    image-fit: contain;
                }
                NavItem {
                    icon: "⌂"; label: "Главная"; selected: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    icon: "⚙"; label: "Дополнительные"; selected: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    icon: "▣"; label: "Моды"; selected: root.page == 2;
                    clicked => { root.page = 2; }
                }
                Rectangle { }
                NavItem {
                    icon: "≡"; label: "Изменения"; selected: root.page == 3;
                    clicked => { root.page = 3; }
                }
                Caption {
                    text: "by cactunus " + root.app-version;
                    horizontal-alignment: center;
                }
            }
        }

        // Контент
        Rectangle {
            background: Theme.bg;

            // ГЛАВНАЯ
            if root.page == 0 : ScrollView {
                VerticalLayout {
                    padding: Theme.page-padding;
                    spacing: Theme.gap;
                    // без этого VerticalLayout раздаёт лишнюю высоту всем
                    // элементам поровну и между подписью и полем зияет дыра
                    alignment: start;
                    Text {
                        text: "Главная";
                        font-family: Theme.font;
                        font-size: Theme.title-size;
                        font-weight: 600;
                        color: Theme.fg;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Caption { text: "НИКНЕЙМ"; }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.nick;
                                placeholder-text: "Никнейм";
                                accepted => { root.launch(); }
                            }
                            SubtleButton {
                                text: "Скин";
                                clicked => { root.pick-skin(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Caption { text: "ВЕРСИЯ"; }
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                model: root.versions;
                                current-value <=> root.version;
                                selected(v) => { root.version-changed(v); }
                            }
                            SubtleButton {
                                text: "+";
                                clicked => { root.add-version(); }
                            }
                        }
                    }
                    AccentButton {
                        text: "ИГРАТЬ";
                        enabled: !root.busy;
                        clicked => { root.launch(); }
                    }
                    if root.busy : ProgressIndicator {
                        progress: root.progress / 100;
                        height: 4px;
                    }
                    if root.busy : Caption { text: "Прогресс: \{Math.round(root.progress)}%"; }
                    Body { text: root.status; color: Theme.muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        SubtleButton {
                            text: "журнал";
                            clicked => { root.toggle-console(); }
                        }
                    }
                    Text {
                        text: root.playtime;
                        font-family: Theme.font;
                        font-size: Theme.body-size;
                        color: Theme.accent;
                    }
                }
            }

            // ДОПОЛНИТЕЛЬНЫЕ
            if root.page == 1 : ScrollView {
                VerticalLayout {
                    padding: Theme.page-padding;
                    spacing: Theme.gap;
                    Text {
                        text: "Дополнительные";
                        font-family: Theme.font;
                        font-size: Theme.title-size;
                        font-weight: 600;
                        color: Theme.fg;
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Caption { text: "ПАПКА ИГРЫ"; }
                            Body { text: root.game-dir; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                SubtleButton { text: "Открыть папку игры"; clicked => { root.open-game-dir(); } }
                                SubtleButton { text: "Сбросить настройки"; clicked => { root.reset-settings(); } }
                                SubtleButton { text: "Сбросить скин"; clicked => { root.reset-skin(); } }
                            }
                        }
                    }
                    Card {
                        HorizontalLayout {
                            padding: 16px;
                            spacing: 16px;
                            Rectangle {
                                width: 112px;
                                height: 168px;
                                border-radius: Theme.radius-small;
                                background: Theme.card;
                                Image {
                                    source: root.skin-preview;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    image-rendering: pixelated;
                                }
                            }
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                Caption { text: "ПРЕДПРОСМОТР СКИНА"; }
                                Body { text: "Скин показан собранной фигурой, лицом к игроку."; }
                                SubtleButton { text: "Выбрать скин"; clicked => { root.pick-skin(); } }
                            }
                        }
                    }
                    Caption { text: "ПОДСИСТЕМА МОДОВ"; }
                    ComboBox {
                        model: root.loaders;
                        current-value <=> root.loader;
                        selected(v) => { root.loader-changed(v); }
                    }
                    Caption { text: "ПАМЯТЬ (GB)"; }
                    ComboBox {
                        model: root.rams;
                        current-value <=> root.ram;
                        selected(v) => { root.ram-changed(v); }
                    }
                    Caption {
                        text: "Авто — лаунчер сам подберёт объём памяти по свободной ОЗУ и требованиям выбранной версии.";
                    }
                    Caption {
                        text: "Не все версии совместимы со всеми подсистемами модов.\nБуквы рядом с версией: F — Forge, G — Fabric, N — NeoForge.\nНесовместимые версии помечены «(недоступна)».";
                    }
                    Caption {
                        text: "ОЗУ определяется автоматически. Пометка «заняты» — этой памяти сейчас не хватает, её выбрать нельзя.";
                    }
                    CheckBox {
                        text: "Докачивать недостающие зависимости модов при запуске игры";
                        checked <=> root.repair-deps-on-launch;
                        toggled => { root.repair-deps-changed(root.repair-deps-on-launch); }
                    }
                    Caption {
                        text: "Если выключить, лаунчер не будет проверять зависимости при запуске — игра запустится быстрее.";
                    }
                }
            }

            // МОДЫ
            if root.page == 2 : ScrollView {
                VerticalLayout {
                    padding: Theme.page-padding;
                    spacing: Theme.gap;
                    Text {
                        text: "Моды";
                        font-family: Theme.font;
                        font-size: Theme.title-size;
                        font-weight: 600;
                        color: Theme.fg;
                    }
                    // Перетаскивание файлов
                    Card {
                        height: 108px;
                        border-color: drop.has-hover ? Theme.accent : Theme.stroke;
                        drop := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick-mod-file(); }
                        }
                        VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: "Перетащите .jar сюда";
                                horizontal-alignment: center;
                                font-family: Theme.font;
                                font-size: Theme.body-strong-size;
                                color: Theme.fg;
                            }
                            Caption {
                                text: "или нажмите, чтобы выбрать файл";
                                horizontal-alignment: center;
                            }
                        }
                    }
                    // Поиск на всю ширину сразу под блоком перетаскивания
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.query;
                            placeholder-text: "Поиск модов на Modrinth";
                            accepted => { root.search-mods(); }
                        }
                        SubtleButton { text: "Найти"; clicked => { root.search-mods(); } }
                    }
                    if root.mods-status != "" : Caption { text: root.mods-status; }
                    if root.found.length > 0 : Caption { text: "РЕЗУЛЬТАТЫ ПОИСКА"; }
                    if root.found.length > 0 : ModGrid {
                        model: root.found;
                        action(t) => {
                            root.mod-dlg-tile = t;
                            root.mod-dlg-version = t.version;
                            root.mod-dlg-found = true;
                            root.mod-dlg-open = true;
                        }
                    }
                    Caption { text: "КАТАЛОГ МОДОВ"; }
                    ModGrid {
                        model: root.catalog;
                        action(t) => {
                            root.mod-dlg-tile = t;
                            root.mod-dlg-version = t.version;
                            root.mod-dlg-found = false;
                            root.mod-dlg-open = true;
                        }
                    }
                    Caption { text: "УСТАНОВЛЕННЫЕ МОДЫ"; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Caption { text: "ИНСТАНС"; vertical-alignment: center; }
                        ComboBox {
                            width: 360px;
                            model: root.installed-instances;
                            current-value <=> root.selected-installed-instance;
                            selected(v) => { root.installed-instance-changed(v); }
                        }
                        SubtleButton { text: "Открыть папку"; clicked => { root.open-mods-dir(); } }
                    }
                    if root.installed-mods.length == 0 : Caption {
                        text: "В выбранном инстансе моды не установлены.";
                    }
                    ModGrid {
                        model: root.installed-mods;
                        action(t) => { root.remove-mod(t.version, t.id); }
                    }
                }
            }

            // ИЗМЕНЕНИЯ
            if root.page == 3 : ScrollView {
                VerticalLayout {
                    padding: Theme.page-padding;
                    spacing: Theme.gap;
                    Text {
                        text: "Изменения";
                        font-family: Theme.font;
                        font-size: Theme.title-size;
                        font-weight: 600;
                        color: Theme.fg;
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;
                            for line in root.changelog : Body { text: line; }
                        }
                    }
                }
            }
        }
    }

    // Окно выбора версии мода (открывается по кнопке «Установить»)
    if root.mod-dlg-open : Rectangle {
        background: #000000cc;
        TouchArea { clicked => { root.mod-dlg-open = false; } }
        Rectangle {
            width: 460px;
            height: 300px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.layer;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.card;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Установка мода";
                    font-family: Theme.font;
                    font-size: Theme.body-strong-size;
                    font-weight: 600;
                    color: Theme.fg;
                }
                Body { text: root.mod-dlg-tile.name; overflow: elide; }
                Caption { text: "MINECRAFT-ИНСТАНС (ВЕРСИЯ И ЗАГРУЗЧИК)"; }
                if root.mod-dlg-tile.versions.length == 0 : Caption {
                    text: "Нет совместимых установленных инстансов. Сначала установите версию и модлоадер кнопкой + на главной.";
                }
                HorizontalLayout {
                    spacing: 10px;
                    Caption { text: "ЦЕЛЕВОЙ ИНСТАНС"; vertical-alignment: center; }
                    ComboBox {
                        model: root.mod-dlg-tile.versions;
                        current-value <=> root.mod-dlg-version;
                    }
                }
                Caption { text: "Мод будет установлен только в папку mods выбранного инстанса."; }
                Rectangle { }
                HorizontalLayout {
                    spacing: 8px;
                    SubtleButton {
                        text: "Отмена";
                        clicked => { root.mod-dlg-open = false; }
                    }
                    AccentButton {
                        text: root.mod-install-busy ? "УСТАНОВКА..." : "УСТАНОВИТЬ";
                        enabled: root.mod-dlg-version != "" && !root.mod-install-busy;
                        clicked => {
                            root.mod-dlg-open = false;
                            if (root.mod-dlg-found) {
                                root.install-found(root.mod-dlg-tile.id, root.mod-dlg-version);
                            } else {
                                root.install-mod(root.mod-dlg-tile.id, root.mod-dlg-version);
                            }
                        }
                    }
                }
            }
        }
    }

    // Окно установки версии Minecraft (кнопка «+» рядом со списком версий)
    if root.add-open : Rectangle {
        background: #000000cc;
        TouchArea { }
        Rectangle {
            width: 460px;
            height: 520px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.layer;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.card;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Установка версии";
                    font-family: Theme.font;
                    font-size: Theme.body-strong-size;
                    font-weight: 600;
                    color: Theme.fg;
                }
                Caption { text: "ВЕРСИЯ MINECRAFT"; }
                LineEdit {
                    placeholder-text: "Фильтр: 1.20, 1.16.5, snapshot...";
                    text <=> root.version-filter;
                    edited(t) => { root.version-filter-changed(t); }
                }
                ScrollView {
                    height: 180px;
                    VerticalLayout {
                        spacing: 2px;
                        for v in root.all-versions : Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: v == root.new-version ? Theme.card : transparent;
                            TouchArea { clicked => { root.new-version = v; } }
                            HorizontalLayout {
                                padding-left: 10px;
                                Body { text: v; vertical-alignment: center; }
                            }
                        }
                    }
                }
                SubtleButton {
                    text: root.only-release ? "Только релизы: вкл" : "Только релизы: выкл";
                    clicked => {
                        root.only-release = !root.only-release;
                        root.only-release-changed(root.only-release);
                    }
                }
                Caption { text: root.add-status; }
                Caption { text: "МОДЛОАДЕР"; }
                ComboBox {
                    model: root.loaders;
                    current-value <=> root.loader;
                    selected(v) => { root.loader-changed(v); }
                }
                Rectangle { }
                HorizontalLayout {
                    spacing: 8px;
                    SubtleButton {
                        text: "Отмена";
                        clicked => { root.add-open = false; }
                    }
                    AccentButton {
                        text: "УСТАНОВИТЬ";
                        enabled: root.new-version != "";
                        clicked => { root.install-version(root.new-version); }
                    }
                }
            }
        }
    }
}
